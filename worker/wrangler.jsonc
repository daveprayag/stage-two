{
  // Stage Two engine: prices, screens, news orchestration, live quotes and the public data API (src/index.ts).
  "name": "stage-two-engine",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "limits": { "cpu_ms": 300000 },
  "vars": { "APP_URL": "https://stage-two-pd.vercel.app" },
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "stage-two-data" }],
  "triggers": {
    "crons": [
      // 17:30–00:29 IST every 15 min: new NSE session → prices, screen, track; then news.
      "*/15 12-18 * * *",
      // 06:45 IST: catch-up in case the evening runs missed the session.
      "15 1 * * *",
      // 08:30–16:29 IST every minute, Mon–Fri: live prices for every stock and index (09:15–15:45); NSE filings every 30 min.
      "* 3-10 * * mon-fri"
    ]
  },
  "observability": { "enabled": true }
}
